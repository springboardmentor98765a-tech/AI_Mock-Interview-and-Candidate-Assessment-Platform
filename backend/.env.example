# ==========================================================
# AI INTERVIEW PRO - ENVIRONMENT VARIABLES
# Copy this file to ".env" and fill in your real values.
# NEVER commit the real ".env" file to version control.
# ==========================================================

# ---------------- PostgreSQL Database ----------------
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/AI_Interview_Pro

# ---------------- JWT Settings ----------------
# Generate a strong random secret, e.g. `openssl rand -hex 32`
JWT_SECRET_KEY=replace_this_with_a_long_random_secret_key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------------- Google OAuth 2.0 ----------------
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ---------------- Session Middleware (required by Authlib OAuth state) ----------------
SESSION_SECRET_KEY=replace_this_with_another_long_random_secret

# ---------------- Gemini (AI interview question generation) ----------------
# Free-tier key: https://aistudio.google.com/app/apikey
# Leave blank to use the built-in local question bank instead.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---------------- Frontend ----------------
# Where the frontend static files are served from (used for redirects after Google login)
FRONTEND_URL=http://127.0.0.1:5500

# ---------------- CORS ----------------
# Comma-separated list of allowed origins
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
