# backend/.env.example
# Copy this file to backend/.env and fill in your real values.
# NEVER commit backend/.env -- it is in .gitignore.

# -- Server -------------------------------------------------------------------
PORT=5000
NODE_ENV=production

# -- PostgreSQL ---------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_recruitment
DB_USER=postgres
DB_PASSWORD=CHANGE_ME

# -- JWT ----------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_use_a_long_random_secret
JWT_EXPIRES_IN=7d

# -- OAuth (optional -- leave blank to disable social login) ------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://YOUR_BACKEND_DOMAIN/api/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://YOUR_BACKEND_DOMAIN/api/auth/github/callback

# -- CORS ---------------------------------------------------------------------
FRONTEND_URL=https://YOUR_FRONTEND_DOMAIN

# -- AI Provider --------------------------------------------------------------
# Choose: ollama  (local/on-prem)  |  gemini  (cloud)
AI_PROVIDER=ollama

# Ollama -- only used when AI_PROVIDER=ollama
# OLLAMA_BASE_URL defaults to http://localhost:11434 if unset.
# Set this when Ollama runs on a separate host/VM.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_FALLBACK_MODEL=qwen2.5:7b

# Gemini -- only used when AI_PROVIDER=gemini
# Supports up to 7 keys for key-rotation / rate-limit distribution.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=

# -- AI Microservices ---------------------------------------------------------
# On a single VM all default to localhost. On separate VMs, set the remote IP.
STT_SERVICE_URL=http://localhost:8765
TTS_PROVIDER=kokoro
TTS_SERVICE_URL=http://localhost:8766
CV_SERVICE_URL=http://localhost:8767

# -- Service-to-service authentication ----------------------------------------
# Shared secret token sent in the X-AI-Secret header from backend to AI services.
# Leave UNSET (or empty) for localhost development — services pass through freely.
# In production, set a strong random value (e.g. openssl rand -hex 32) and set
# the SAME value on EVERY AI service VM via its own environment variables.
# NEVER expose this value to the browser or commit it to Git.
AI_SECRET_TOKEN=

# -- Email / SMTP (optional -- leave blank to disable email sending) -----------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HireAI <no-reply@yourdomain.com>
REMINDER_INTERVAL_MS=60000

# -- Rate limiting (optional overrides — defaults shown) ----------------------
# All limits apply per-IP per window. Leave unset to use the defaults below.
# Increase on localhost if automated tests or high-volume dev work is blocked.
#
# RATE_AUTH_MAX=20         # login attempts per 15-minute window (default: 20)
# RATE_REGISTER_MAX=10     # registration attempts per 60-minute window (default: 10)
# RATE_AI_GENERATE_MAX=30  # interview generation requests per 60-minute window (default: 30)
# RATE_STT_MAX=60          # STT transcription requests per 15-minute window (default: 60)
# RATE_HEALTH_MAX=30       # /api/health requests per 1-minute window (default: 30)
