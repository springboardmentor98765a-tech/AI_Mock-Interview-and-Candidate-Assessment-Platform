# Copy to .env and fill in. Never commit .env.

PROJECT_NAME="SmartHire AI API"

# PostgreSQL. Create the database in pgAdmin4 first, then put your password here.
DATABASE_URL="postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/smarthire"

# Sign JWTs with this. Generate one with:  openssl rand -hex 32
JWT_SECRET_KEY="replace-with-a-long-random-string"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth2 — create at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI must exactly match GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/auth/google/callback"

# Where to send the browser back to after a successful Google login
FRONTEND_URL="http://localhost:3000"

# Origins allowed to call this API
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5453","http://127.0.0.1:3000"]
