# Copy this file to server/.env and replace the placeholders.
PORT=8080
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN_MINUTES=12506
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
DB_PATH=data/smarthire.db

# Resend Mail Configuration
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=SmartHire AI <no-reply@your-verified-domain.com>
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=5
ADMIN_EMAILS=admin@example.com

# MIMO Configuration
MIMO_API_KEY=your_mimo_api_key_here
MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
MIMO_CHAT_MODEL=mimo-v2.5

# AICredits Configuration
AICREDITS_API_KEY=your_aicredits_api_key_here
AICREDITS_BASE_URL=https://aicredits.in/v1
AICREDITS_MODEL=deepseek/deepseek-v4-flash-0731

# Sarvam Configuration
SARVAM_API_KEY=your_sarvam_api_key_here

# Gemini Configurations & Fallback API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

GEMINI_API_KEY_2=your_gemini_api_key_2_here
GEMINI_MODEL_2=gemini-3.5-flash

GEMINI_API_KEY_3=your_gemini_api_key_3_here
GEMINI_MODEL_3=gemini-3.5-flash-lite

GEMINI_API_KEY_4=your_gemini_api_key_4_here
GEMINI_MODEL_4=gemini-3.1-flash-lite

GEMINI_RESUME_KEY=your_gemini_resume_key_here
GEMINI_RESUME_MODEL=gemini-3.5-flash-lite
GEMINI_RESUME_KEY_2=your_gemini_resume_key_2_here
GEMINI_RESUME_MODEL_2=gemini-3.1-flash-lite

GEMINI_QUESTION_KEY=your_gemini_question_key_here
GEMINI_QUESTION_MODEL=gemini-3.6-flash
GEMINI_QUESTION_KEY_2=your_gemini_question_key_2_here
GEMINI_QUESTION_MODEL_2=gemini-3.5-flash

GEMINI_QUIZ_KEY=your_gemini_quiz_key_here
GEMINI_QUIZ_KEY_2=your_gemini_quiz_key_2_here
