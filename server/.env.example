# Copy this file to server/.env and replace the placeholders.
PORT=8080
JWT_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=
JWT_ALGORITHM=
JWT_EXPIRES_IN_MINUTES=10080
RESEND_API_KEY=re_your_resend_api_key
# Use a sender from a domain verified in your Resend account.
RESEND_FROM_EMAIL=SmartHire AI <no-reply@your-verified-domain.com>
APP_BASE_URL=http://localhost:8080
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=30