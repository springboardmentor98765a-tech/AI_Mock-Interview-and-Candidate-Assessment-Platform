# Single source of truth for the Postgres container's credentials when
# running via `docker compose`. Copy this to .env and set a real
# password. docker-compose.yml forces backend and backend-python to use
# these exact same values too (see the comment block at the top of that
# file), so you only need to set this once here — you do NOT also need
# to keep backend/.env's and backend-python/.env's DB_* lines in sync
# with this when running under Docker.
DB_USER=postgres
DB_PASSWORD=Asfiya@123
DB_NAME=ai_interview_platform
