# ============================================================
# This Python service talks to the SAME PostgreSQL database as
# the existing Node backend, and trusts the SAME JWT_SECRET so
# a token issued by /api/auth/login (Node) works here too.
# Copy these values straight from backend/.env.
# ============================================================

PY_PORT=8001
FRONTEND_URL=http://localhost:5500

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=ai_interview_platform

# Must be IDENTICAL to backend/.env's JWT_SECRET
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_ALGORITHM=HS256

# Where generated question audio files are cached on disk
TTS_CACHE_DIR=tts_cache
# Default language/accent for gTTS (see gTTS docs for options)
TTS_LANG=en
TTS_TLD=co.in

# Where proctored-session video+audio recordings are stored on disk,
# and the largest single recording the server will accept (in MB).
RECORDINGS_DIR=recordings
MAX_RECORDING_SIZE_MB=300

# ============================================================
# Multi-provider AI engine (app/ai_providers.py) — dynamic question
# generation + real answer scoring. Providers are tried in this
# order; on failure/rate-limit it automatically falls through to the
# next one. Leave everything blank/default and it still works: Ollama
# running locally is enough, and if even that isn't running, the app
# falls back to the curated question bank (question_bank.py) so it
# never breaks.
# ============================================================
AI_PROVIDER_ORDER=ollama,gemini,openai,grok

# Free local option — install from https://ollama.com, then:
#   ollama pull llama3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Google Gemini — put MULTIPLE keys here, comma-separated, to rotate
# across them and dodge per-key free-tier rate limits (this is the
# #1 fix for "it keeps generating the same questions"). Get keys at
# https://aistudio.google.com/app/apikey — a few free Google accounts
# will get you 4-5 keys in a couple of minutes.
GEMINI_API_KEYS=key_one,key_two,key_three,key_four,key_five
GEMINI_MODEL=gemini-2.0-flash

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Grok (xAI) — https://console.x.ai
GROK_API_KEY=
GROK_MODEL=grok-2-latest

# Per-request timeout (seconds) for every provider call
AI_REQUEST_TIMEOUT=20
