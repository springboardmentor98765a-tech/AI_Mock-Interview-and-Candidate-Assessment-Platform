# Used by docker-compose.prod.yml. Keep the real file private.
POSTGRES_PASSWORD=replace_with_a_strong_database_password
DATABASE_URL=postgresql://postgres:replace_with_url_encoded_database_password@postgres:5432/AI_Interview_Pro
PUBLIC_URL=https://interview.example.com
WEB_PORT=80
GMAIL_CLIENT_ID=your_desktop_oauth_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_desktop_oauth_client_secret
GMAIL_REFRESH_TOKEN=your_refresh_token
GMAIL_FROM=your_sender@gmail.com
