POSTGRES_DB=smarthire
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
APP_CORS_ALLOWED_ORIGINS=*
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
APP_JWT_SECRET=smarthire-secret-key-smarthire-secret-key-123456
APP_JWT_EXPIRATION_MS=86400000

# Short Gemini read timeout so interview question generation falls back quickly if AI is busy
GEMINI_READ_TIMEOUT_SECONDS=12

# Optional Google OAuth2 (activate Spring profile 'oauth')
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional Google OAuth2 (activate Spring profile 'oauth')
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 5500 for the local PowerShell "python -m http.server 5500" startup flow;
# 5173 if you are instead running the dockerized nginx frontend container.
APP_FRONTEND_BASE_URL=http://localhost:5500

# Optional real AI services included in this repository
AI_WHISPER_URL=http://whisper:8091
AI_WHISPER_ENABLED=true
AI_DEEPFACE_URL=http://deepface:8092
AI_DEEPFACE_ENABLED=true
AI_MEDIAPIPE_URL=http://mediapipe:8093
AI_MEDIAPIPE_ENABLED=true

# Custom CNN emotion detection service (Module 6). Local PowerShell startup
# runs this on port 8095; docker-compose uses the "emotion-cnn" service name.
AI_EMOTION_CNN_URL=http://localhost:8095
AI_EMOTION_CNN_ENABLED=true

# Optional camera-visible prohibited-object detection
AI_OBJECT_DETECTION_URL=http://localhost:8094
AI_OBJECT_DETECTION_ENABLED=true
