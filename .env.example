# .env.example  (root — Vite frontend)
# Copy this file to .env and set VITE_API_URL for your deployment target.
# In local development, leave VITE_API_URL unset -- the Vite dev server
# proxy in vite.config.js forwards /api/* to http://localhost:5000 automatically.

# Production: set to the full HTTPS URL of your backend, WITHOUT a trailing slash.
# Example:
#   VITE_API_URL=https://api.hireai.example.com
VITE_API_URL=
